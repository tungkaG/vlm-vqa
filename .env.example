# API keys for the VLM providers.
# Copy this file to ".env" and fill in your real keys. Never commit ".env".

# Default provider: NVIDIA NIM (Nemotron 3 Nano Omni).
NVIDIA_API_KEY=

# Optional: Gemini (set llm.provider=gemini in the config to use).
GEMAI_API_KEY=

# Optional: override the default model from the config file.
# LLM_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional: activate mock mode (no API calls, deterministic canned JSON).
# LLM_MOCK=1
